{
  "name": "ai-hell",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "description": "AI Hell — a Phaser 4 + TypeScript shoot-em-up built with AI assistance (see GDD).",
  "scripts": {
    "dev": "vite",
    "build-audio": "scripts/build-audio.sh",
    "build-audio:render": "scripts/build-audio.sh --render",
    "build-audio:verify": "scripts/build-audio.sh --verify && node scripts/audio-balance-guard.mjs",
    "check-bundle": "node scripts/check-bundle-hygiene.mjs",
    "build": "npm run build-audio && tsc --noEmit && vite build && npm run check-bundle",
    "preview": "vite preview --port 4173",
    "capture": "node scripts/capture-gameplay.mjs",
    "list:pool": "node scripts/list-capture-pool.mjs",
    "compile:promo": "node scripts/compile-promo.mjs --compile",
    "evaluate": "node scripts/evaluate.mjs",
    "capture:install": "playwright install chromium",
    "record": "node scripts/record-session.mjs",
    "analyse": "node scripts/analyse-recording.mjs",
    "replay": "node scripts/replay-recording.mjs",
    "telemetry:inspect": "node scripts/inspect-telemetry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "toneforge": "file:../ToneForge"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.11.6",
    "playwright": "^1.55.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
