#!/bin/sh
# worklog:pre-push-hook:v3
# 1. Auto-sync Worklog data before pushing (committed hooks).
# 2. Enforce branch naming policy: block pushes to protected branches.
# 3. Context-budget regression gate (F6, SA-0MSLK7XNZ00366YY): fail the push
#    when the startup context surface exceeds committed thresholds.
# 4. Scope-aware full-suite gate (SA-0MT6CEN8D0073F61, SA-0MVECQUGF0064U81):
#    run the FULL canonical suite when a pushed remote ref is refs/heads/dev or
#    refs/heads/main. Feature-branch, tag and refs/worklog/data pushes run no
#    tests — implementation validated changed scope only; the full suite first
#    runs at this dev-push integration gate.
# 4a. Pushed-commit subject (SA-0MVTRBT50005DUEH): the gate is evidence about
#    the commit it pushes, never about whichever tree the hook happens to run
#    in. The pushed <local_sha> is forwarded as `run_tests.py --gate-commit`,
#    which resolves a checkout whose HEAD is that commit with no dirty paths
#    (in place, else a clean `git worktree list` checkout) and runs/caches the
#    suite there. When no clean checkout holds the commit the push is refused
#    (fail closed) instead of reporting a verdict about a different tree. The
#    runner emits `run_tests: gate-*` provenance lines on stderr; the hook
#    echoes them and mirrors the resolved checkout's cache into the main
#    checkout so post-push verification and the audit can read it.
# 4b. Cache mirroring (SA-0MVTFMB7K002Y1F3): `implement.py finish` pushes from
#    the linked worktree that holds the commit, so the gate caches under that
#    worktree's cache — invisible to the main checkout's post-push
#    verification and to audits, which read <main>/.worklog/cache.
#
# Why this file matters here (AH-0MW28RGA6008DFT1): after a dev push,
# `implement.py finish` verifies that a green full-suite cache entry exists for
# the pushed tree and refuses the terminal transition ("no valid full-suite
# cache entry") when it does not. This hook is what produces that entry, so a
# copy of it that predates the full-suite gate (the v2 template) makes every
# dev push refuse and files a false critical `test-failure` item. Keep it in
# step with the framework template: `wl doctor upgrade --dry-run`.
#
# Set WORKLOG_SKIP_PRE_PUSH=1 to bypass worklog sync.
# Set BRANCH_POLICY_SKIP=1 to bypass branch policy check (not recommended).
# Set CONTEXT_BUDGET_SKIP=1 to bypass the context-budget gate (not recommended).
# Set TEST_SCOPE_SKIP=1 to bypass the full-suite gate on a dev/main push (not recommended).
set -e

# ── Branch policy enforcement ────────────────────────────────────────────────
# Check that the current branch is not a protected branch.
if [ "$BRANCH_POLICY_SKIP" != "1" ]; then
  current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  # Protected branches that agents must never push to.
  blocked_branches="main master HEAD"
  for blocked in $blocked_branches; do
    if [ "$current_branch" = "$blocked" ]; then
      echo "ERROR: Push to '$current_branch' is blocked by branch policy." >&2
      echo "  Regular agents must NOT push directly to main." >&2
      echo "  Work in feature branches (wl-<id>-<desc>) and push into dev." >&2
      echo "  See the framework ship skill for the push-to-dev workflow." >&2
      exit 1
    fi
  done
fi

# ── Context-budget regression gate ──────────────────────────────────────────
# Fail the push when the pi session startup context surface exceeds the
# committed thresholds (docs/dev/context-budget.thresholds.json). The gate is
# fail-open when the tooling or thresholds file is absent (e.g. worktrees of
# old commits, or repositories that do not ship the context-audit skill).
# measure_context.py is resolved first from the local skill/context-audit/
# path, then from the installed global symlink
# (~/.pi/agent/skills/context-audit/scripts/measure_context.py) installed by
# the framework's install_pi.sh.
if [ "$CONTEXT_BUDGET_SKIP" != "1" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -f "$repo_root/skill/context-audit/scripts/measure_context.py" ]; then
    measure="$repo_root/skill/context-audit/scripts/measure_context.py"
  elif [ -f "$HOME/.pi/agent/skills/context-audit/scripts/measure_context.py" ]; then
    measure="$HOME/.pi/agent/skills/context-audit/scripts/measure_context.py"
  else
    measure=""
  fi
  thresholds="$repo_root/docs/dev/context-budget.thresholds.json"
  if [ -n "$repo_root" ] && [ -n "$measure" ] && [ -f "$measure" ] && [ -f "$thresholds" ]; then
    # Pass --repo-root explicitly: when the global symlink is used, the
    # script's default repo-root resolves to the symlink target instead of the
    # project being pushed.
    if python3 "$measure" --repo-root "$repo_root" --include-hidden --thresholds "$thresholds" >/dev/null 2>&1; then
      :
    else
      echo "ERROR: Context budget exceeded committed thresholds." >&2
      echo "  Run: python3 $measure --repo-root $repo_root --include-hidden --thresholds $thresholds" >&2
      echo "  See docs/dev/context-budget.md. Set CONTEXT_BUDGET_SKIP=1 to bypass." >&2
      exit 1
    fi
  fi
fi

# ── Pushed refs (stdin is read exactly once) ────────────────────────────────
# git feeds one line per pushed ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# The first reader consumes it, so every fact the gate and the worklog-sync
# skip need is captured here.
need_full_suite=0
skip_worklog_sync=0
gated_ref_shas=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_ref" ] || continue
  case "$remote_ref" in
    refs/heads/dev|refs/heads/main)
      need_full_suite=1
      # A deletion push carries the all-zero sha: there is no commit to gate.
      case "$local_sha" in
        ''|*[!0]*) gated_ref_shas="$gated_ref_shas $remote_ref=$local_sha" ;;
      esac
      ;;
    refs/worklog/data) skip_worklog_sync=1 ;;
  esac
done

# Mirror the test-runner cache entries a worktree gate run wrote into the main
# checkout's cache (SA-0MVTFMB7K002Y1F3). Keys are content-addressed (command +
# git state), so copying an entry the main cache lacks is always safe: an
# identical key is an identical run. Fail-soft — cache plumbing must never
# decide a push.
mirror_suite_cache() {
  wt_root="$1"
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
  [ -n "$git_dir" ] && [ -d "$git_dir" ] || return 0
  if [ -d "$wt_root/.worklog" ]; then
    wt_cache="$wt_root/.worklog/cache"
  else
    wt_cache="$git_dir/test-cache"
  fi
  [ -d "$wt_cache" ] && [ -n "$(ls -A "$wt_cache" 2>/dev/null)" ] || return 0
  common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
  case "$common_dir" in
    /*) main_git_dir="$common_dir" ;;
    *) main_git_dir="$(cd "$wt_root" && pwd)/$common_dir" ;;
  esac
  main_root="$(dirname "$main_git_dir")"
  [ "$main_root" != "$wt_root" ] || return 0
  main_cache="$main_root/.worklog/cache"
  [ -d "$main_cache" ] || return 0
  for entry in "$wt_cache"/*; do
    [ -d "$entry" ] || continue
    name="$(basename "$entry")"
    [ -e "$main_cache/$name" ] && continue
    if cp -a "$entry" "$main_cache/$name" 2>/dev/null; then
      echo "pre-push: mirrored gate cache entry $name into $main_root/.worklog/cache" >&2
    else
      echo "pre-push: warning: could not mirror cache entry $name into $main_root/.worklog/cache" >&2
    fi
  done
  return 0
}

# ── Full-suite gate (dev/main pushes) ───────────────────────────────────────
# Partial runs are never full-suite evidence, so the gate always runs
# scope=full, and it is bound to the pushed commit: `--gate-commit <sha>` makes
# the runner resolve (and cache against) a clean checkout of exactly that
# commit, or refuse. run_tests.py is resolved first from the local skill/test/
# path (framework repos), then from the installed global symlink
# (~/.pi/agent/skills/test/scripts/run_tests.py) installed by install_pi.sh —
# project repositories such as this one have no committed skill/ tree. A
# missing runner hard-fails: silently skipping would reproduce the unenforced
# gate this hook exists to close (AH-0MW28RGA6008DFT1).
if [ "$need_full_suite" = "1" ] && [ "$TEST_SCOPE_SKIP" != "1" ]; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -f "$repo_root/skill/test/scripts/run_tests.py" ]; then
    runner="$repo_root/skill/test/scripts/run_tests.py"
  elif [ -f "$HOME/.pi/agent/skills/test/scripts/run_tests.py" ]; then
    runner="$HOME/.pi/agent/skills/test/scripts/run_tests.py"
  else
    runner=""
  fi
  if [ -z "$runner" ]; then
    echo "ERROR: Full-suite gate cannot run - run_tests.py not found." >&2
    echo "  Refusing to push to dev/main without a full-suite assertion." >&2
    echo "  Install the framework skills (install_pi.sh) or set TEST_SCOPE_SKIP=1 to bypass." >&2
    exit 1
  fi

  # One suite can evidence one commit. A push carrying several different
  # dev/main commits would need a run per commit (the gate must not run more
  # than one full suite), so refuse and let the pusher split the push.
  gate_commit=""
  for entry in $gated_ref_shas; do
    entry_sha="${entry#*=}"
    if [ -z "$gate_commit" ]; then
      gate_commit="$entry_sha"
    elif [ "$gate_commit" != "$entry_sha" ]; then
      {
        echo "ERROR: pre-push gate cannot evidence one suite for several pushed commits."
        echo "  pushed:"
        for ref_entry in $gated_ref_shas; do
          echo "    ${ref_entry%%=*} ${ref_entry#*=}"
        done
        echo "  The full-suite gate runs at most one suite and binds it to one commit."
        echo "  Recovery: push the dev/main refs one at a time (one commit per push)."
        echo "  Escape hatch (explicit, not recommended): TEST_SCOPE_SKIP=1 or git push --no-verify."
      } >&2
      exit 1
    fi
  done

  gate_err="$(mktemp 2>/dev/null || echo "/tmp/pre-push-gate.$$")"
  # `set -e` is disabled for commands in an `if` condition: the gate's own
  # non-zero exit is a verdict, not a hook failure, so it is classified below.
  if [ -n "$gate_commit" ]; then
    echo "pre-push: full-suite gate for dev/main push — running run_tests.py --scope full --strict-git-env --gate-commit $gate_commit" >&2
    if python3 "$runner" --scope full --strict-git-env --json \
      --project-root "$repo_root" --gate-commit "$gate_commit" \
      >/dev/null 2>"$gate_err"; then
      gate_status=0
    else
      gate_status=$?
    fi
  else
    echo "pre-push: full-suite gate for dev/main push — running run_tests.py --scope full --strict-git-env" >&2
    if python3 "$runner" --scope full --strict-git-env --json \
      --project-root "$repo_root" \
      >/dev/null 2>"$gate_err"; then
      gate_status=0
    else
      gate_status=$?
    fi
  fi
  # Surface the runner's gate provenance/refusal lines to the pusher: which
  # state was validated, and executed-vs-cached.
  grep '^run_tests: gate-' "$gate_err" >&2 || true
  if [ "$gate_status" -eq 0 ]; then
    echo "pre-push: full suite green (cached runs make repeat pushes cheap)" >&2
    # Mirror the cache of the checkout the gate actually resolved (it may be a
    # worktree other than this one) into the main checkout's cache.
    gate_root="$(sed -n 's/^run_tests: gate-root //p' "$gate_err" | head -1)"
    mirror_suite_cache "${gate_root:-$repo_root}"
    rm -f "$gate_err"
  else
    echo "ERROR: Full test suite failed — pushes to dev/main require a green suite." >&2
    if [ -n "$gate_commit" ]; then
      echo "  gated commit: $gate_commit${gated_ref_shas:+ (from:$gated_ref_shas)}" >&2
    fi
    echo "  Run: python3 \"$runner\" --scope full  (or implement.py finish) and fix failures." >&2
    echo "  Set TEST_SCOPE_SKIP=1 to bypass (not recommended)." >&2
    tail -n 20 "$gate_err" | sed 's/^/    /' >&2 || true
    rm -f "$gate_err"
    exit 1
  fi
fi

# ── Worklog sync ─────────────────────────────────────────────────────────────
if [ "$WORKLOG_SKIP_PRE_PUSH" = "1" ]; then
  echo "worklog: pre-push sync skipped (WORKLOG_SKIP_PRE_PUSH=1)"
  exit 0
fi

# Skip when running inside a temp worktree created by withTempWorktree
# for internal sync operations. These worktrees don't have worklog
# initialized and the push is already done with --no-verify as defense.
case "$PWD" in
  *tmp-worktree-*)
    exit 0
    ;;
esac

# Skip when inside a git worktree (not the main checkout).
# Worktrees are for feature development and typically don't have worklog
# initialized. The sync should run from the main checkout.
if [ "$(git rev-parse --git-dir 2>/dev/null)" != "$(git rev-parse --git-common-dir 2>/dev/null)" ]; then
  exit 0
fi

# Skip the sync when pushing to refs/worklog/data to avoid infinite loops.
if [ "$skip_worklog_sync" = "1" ]; then
  exit 0
fi

if command -v wl >/dev/null 2>&1; then
  WL=wl
elif command -v worklog >/dev/null 2>&1; then
  WL=worklog
else
  echo "worklog: wl/worklog not found; skipping pre-push sync" >&2
  exit 0
fi

# Force the data branch to refs/worklog/data regardless of config.
# This prevents the sync from accidentally pushing to a standard branch
# if the user has overridden syncBranch in the worklog config.
"$WL" sync --git-branch refs/worklog/data || {
  echo "worklog: pre-push sync failed (pushing anyway)" >&2
  exit 0
}
exit 0
