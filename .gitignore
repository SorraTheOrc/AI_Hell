##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/

# Keep defaults and plugins tracked
!.worklog/config.defaults.yaml
!.worklog/plugins/
!.worklog/plugins/**

# opencode temporary files
.opencode/tmp/

# Node / build artifacts
node_modules
node_modules/
dist/
*.tsbuildinfo

# Vite dev server
*.local

# Automated gameplay capture output (spike AH-0MUWMFF3C002WOBK) —
# generated locally by `npm run capture`, never committed.
capture-output/

# Dev play recordings (AH-0MUY08W7Y004GATZ) — generated locally by
# `npm run record`, never committed.
recordings/

# Same-seed evaluation artifacts (AH-0MUY08XLD009K4W4) — generated locally
# by `npm run evaluate`, never committed.
eval-output/

# Performance measurement artifacts (AH-0MVXV0E8000937U5) — raw CDP CPU
# profiles and per-run harness JSON are generated locally by
# `npm run perf:measure`, never committed. The published baseline numbers live
# in docs/PERFORMANCE.md and docs/perf/.
perf-output/

# Crash-safety journal for the `--tune` CSV edit (AH-0MVSE1A7O002PXAO):
# written beside the balance CSV before the first edited byte and removed
# after the restore, so a hard-killed run never shows up as a worktree change.
src/data/*.tune-journal

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# implement skill state file
.implement_state.json

# herdr downtime marker
.herdr-downtime-disabled

# Editor/merge backup files — prevent stray artefacts like the
# src/vfx/wormholeSpawn.ts.orig left by AH-0MVD2N333004VDA9/4b407b66
# from being committed again.
*.orig

### End of Worklog Specific Ignores
